#!/usr/bin/env python3
"""sprig-llama: a client layer between sprig and an OpenAI/Anthropic-style server.

Sprig drives the `claude` CLI over stdio: it writes user-message JSON lines
to stdin and reads stream-json records back. llama.cpp is an HTTP server
instead, and it is stateless. This script bridges the two, and owns the
conversation so sprig does not have to.

It speaks the subset of the CLI's wire protocol sprig actually reads:

  in   {"type": "user", "message": {...}}
       {"type": "control_request", "request_id": ..., "request": {...}}

  out  {"type": "system", "subtype": "init", "session_id":, "cwd":, "model":}
       {"type": "stream_event", "event": {...}}        one per SSE frame
       {"type": "result", "total_cost_usd":, "is_error":}
       {"type": "system", "subtype": "error", "message":}
       {"type": "control_response", "request_id":, "response": {...}}

It also writes a `<id>.jsonl` log in the CLI's own record shape, under the
projects directory, so sprig's replay (`sprig-session-record-events`) and
`--resume` work with no special case on the Emacs side.

llama.cpp's /v1/messages route already emits Anthropic-shaped streaming
events, which is what makes the relay a rewrap rather than a translation.

Stdlib only, like the broker: sprig ships it to hosts that have python3.
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

VERSION = "1"

DEFAULT_BASE_URL = os.environ.get("SPRIG_LLAMA_BASE_URL", "http://127.0.0.1:8080")
DEFAULT_PROJECTS = os.environ.get("SPRIG_LLAMA_PROJECTS", "~/.sprig-llama/projects")


def now():
    return datetime.now(timezone.utc).isoformat()


def emit(record):
    """Write one wire record to stdout. Flushed: sprig streams these."""
    sys.stdout.write(json.dumps(record) + "\n")
    sys.stdout.flush()


def emit_error(message):
    emit({"type": "system", "subtype": "error", "message": str(message)})


class Log:
    """The `<id>.jsonl` session log, in the CLI's record shape.

    Sprig finds it by `directory-files-recursively` on the file name, so the
    project sub-directory is ours to name; the slug just keeps it readable.
    """

    def __init__(self, root, cwd, session_id):
        slug = str(cwd).replace("/", "-").strip("-") or "root"
        self.dir = Path(root).expanduser() / slug
        self.dir.mkdir(parents=True, exist_ok=True)
        self.path = self.dir / f"{session_id}.jsonl"

    def append(self, record):
        with self.path.open("a") as f:
            f.write(json.dumps(record) + "\n")

    def read(self):
        if not self.path.exists():
            return []
        records = []
        with self.path.open() as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    records.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
        return records


def messages_from_log(records):
    """Rebuild the API message list from stored log records."""
    messages = []
    for record in records:
        kind = record.get("type")
        if kind not in ("user", "assistant"):
            continue
        message = record.get("message") or {}
        content = message.get("content")
        if content:
            messages.append({"role": message.get("role", kind), "content": content})
    return messages


class Relay:
    """Accumulates an assistant message from the streamed frames.

    The frames go straight to sprig; this rebuilds the finished message so it
    can go into the history and the log, which is what makes the next turn
    carry the conversation without sprig holding any of it.
    """

    def __init__(self):
        self.blocks = {}
        self.order = []
        self.usage = {}
        self.stop_reason = None

    def frame(self, event):
        kind = event.get("type")

        if kind == "message_start":
            self.usage = (event.get("message") or {}).get("usage", {}) or {}

        elif kind == "content_block_start":
            index = event.get("index")
            block = dict(event.get("content_block") or {})
            # Tool input arrives as partial_json deltas; collect them in a
            # buffer and parse once the block closes.
            if block.get("type") == "tool_use":
                block["input"] = {}
                block["_json"] = ""
            self.blocks[index] = block
            self.order.append(index)

        elif kind == "content_block_delta":
            index = event.get("index")
            block = self.blocks.get(index)
            if block is None:
                return
            delta = event.get("delta") or {}
            dtype = delta.get("type")
            if dtype == "text_delta":
                block["text"] = block.get("text", "") + delta.get("text", "")
            elif dtype == "thinking_delta":
                block["thinking"] = block.get("thinking", "") + delta.get("thinking", "")
            elif dtype == "input_json_delta":
                block["_json"] = block.get("_json", "") + delta.get("partial_json", "")

        elif kind == "content_block_stop":
            block = self.blocks.get(event.get("index"))
            if block is not None and "_json" in block:
                raw = block.pop("_json")
                try:
                    block["input"] = json.loads(raw) if raw.strip() else {}
                except json.JSONDecodeError:
                    # Keep the turn alive: an unparseable input is better
                    # reported to the model than crashed on.
                    block["input"] = {}

        elif kind == "message_delta":
            delta = event.get("delta") or {}
            self.stop_reason = delta.get("stop_reason", self.stop_reason)
            self.usage.update(event.get("usage") or {})

    def content(self):
        out = []
        for index in self.order:
            block = dict(self.blocks.get(index) or {})
            block.pop("_json", None)
            if block:
                out.append(block)
        return out


def request_body(args, messages):
    body = {
        "model": args.llama_model,
        "max_tokens": args.max_tokens,
        "stream": True,
        "messages": messages,
        "chat_template_kwargs": {"enable_thinking": args.thinking},
    }
    if args.append_system_prompt:
        body["system"] = args.append_system_prompt
    return body


def run_turn(args, messages, relay):
    """POST one turn and relay its frames. Returns True on success."""
    url = args.base_url.rstrip("/") + "/v1/messages"
    request = urllib.request.Request(
        url,
        data=json.dumps(request_body(args, messages)).encode(),
        headers={"Content-Type": "application/json", "anthropic-version": "2023-06-01"},
    )

    try:
        with urllib.request.urlopen(request, timeout=args.timeout) as response:
            for raw in response:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if not payload or payload == "[DONE]":
                    continue
                try:
                    event = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                relay.frame(event)
                emit({"type": "stream_event", "event": event})
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace")[:400]
        emit_error(f"{url} returned {exc.code}: {detail}")
        return False
    except urllib.error.URLError as exc:
        emit_error(f"cannot reach {url}: {exc.reason}")
        return False
    except TimeoutError:
        emit_error(f"{url} timed out after {args.timeout}s")
        return False

    return True


def handle_user(args, state, record):
    message = record.get("message") or {}
    content = message.get("content")
    if not content:
        return

    state["messages"].append({"role": "user", "content": content})
    state["log"].append(
        {"type": "user", "message": {"role": "user", "content": content},
         "timestamp": now(), "isSidechain": False}
    )

    relay = Relay()
    ok = run_turn(args, state["messages"], relay)

    content_out = relay.content()
    if content_out:
        state["messages"].append({"role": "assistant", "content": content_out})
        state["log"].append(
            {"type": "assistant",
             "message": {"role": "assistant", "model": args.llama_model,
                         "content": content_out, "usage": relay.usage},
             "timestamp": now(), "isSidechain": False}
        )

    # Cost is unknown and genuinely zero here: it is local compute, not billed.
    emit({"type": "result", "subtype": "success" if ok else "error",
          "total_cost_usd": 0, "is_error": not ok})


def handle_control(record):
    """Acknowledge a control request.

    Sprig sends `initialize`, `interrupt` and `set_permission_mode`. There is
    no agent here to interrupt or to put into plan mode, so these are
    acknowledged rather than acted on; sprig only needs the receipt to settle
    its own state.
    """
    emit({"type": "control_response",
          "request_id": record.get("request_id"),
          "response": {"subtype": "success"}})


def parse_args(argv):
    parser = argparse.ArgumentParser(add_help=False)

    # Flags sprig passes for the CLI's benefit. Accepted and ignored, so the
    # argv sprig builds needs no special case.
    parser.add_argument("-p", "--print", action="store_true")
    parser.add_argument("--input-format")
    parser.add_argument("--output-format")
    parser.add_argument("--include-partial-messages", action="store_true")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--permission-prompt-tool")
    parser.add_argument("--fork-session", action="store_true")

    # Flags that mean something here.
    parser.add_argument("--model", dest="model")
    parser.add_argument("--append-system-prompt")
    parser.add_argument("--resume")

    # Our own.
    parser.add_argument("--base-url", default=DEFAULT_BASE_URL)
    parser.add_argument("--llama-model", default="local")
    parser.add_argument("--projects-dir", default=DEFAULT_PROJECTS)
    parser.add_argument("--cwd")
    parser.add_argument("--max-tokens", type=int, default=4096)
    parser.add_argument("--timeout", type=float, default=900.0)
    parser.add_argument("--thinking", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("-h", "--help", action="help")

    args = parser.parse_args(argv)

    # `--model` is what sprig already sends; let it name the served model so
    # `sprig-model' keeps working, with `--llama-model' as the explicit form.
    if args.model:
        args.llama_model = args.model
    return args


def main():
    args = parse_args(sys.argv[1:])

    if args.version:
        print(VERSION)
        return 0

    cwd = args.cwd or os.getcwd()
    if args.cwd:
        os.chdir(os.path.expanduser(args.cwd))

    # A fork resumes the history under a new id, leaving the parent log alone.
    resumed = args.resume
    session_id = str(uuid.uuid4()) if (not resumed or args.fork_session) else resumed

    messages = []
    if resumed:
        messages = messages_from_log(Log(args.projects_dir, cwd, resumed).read())

    log = Log(args.projects_dir, cwd, session_id)
    if args.fork_session and messages:
        # Carry the replayed history into the fork's own log, so a later
        # resume of the fork stands on its own.
        for message in messages:
            log.append({"type": message["role"], "message": message,
                        "timestamp": now(), "isSidechain": False})

    emit({"type": "system", "subtype": "init", "session_id": session_id,
          "cwd": cwd, "model": args.llama_model})

    state = {"messages": messages, "log": log}

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            emit_error(f"unparseable input line: {line[:200]}")
            continue

        kind = record.get("type")
        if kind == "user":
            handle_user(args, state, record)
        elif kind == "control_request":
            handle_control(record)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
